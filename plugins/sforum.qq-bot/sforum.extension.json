{
  "admin": {
    "entry": "/settings",
    "pages": [
      {
        "description": "新帖推送到 QQ 群、消息模板、群 ID 识别与推送状态。",
        "group": "integration",
        "icon": "i-tabler-brand-qq",
        "label": "QQ 机器人",
        "menu": true,
        "order": 56,
        "path": "/settings",
        "view": "settings"
      }
    ]
  },
  "aiTools": [
    {
      "contractVersion": "sforum.qq-bot.tool.preview@1",
      "description": "仅供管理员在插件设置页点「预览（不发送）」按钮使用，模型不应调用。它用设置页当前草稿值渲染一条样例消息，回报渲染结果、是否被截断以及未识别的变量名，不发送任何消息。",
      "handler": "sforum.qq-bot.tool.preview",
      "id": "sforum.qq-bot.tool.preview",
      "name": "qq-bot-preview",
      "parameters": {
        "properties": {
          "excerpt_limit": {
            "description": "设置页草稿中的摘要长度上限，0 表示不显示摘要。",
            "type": "string"
          },
          "max_message_chars": {
            "description": "设置页草稿中的消息字数上限。",
            "type": "string"
          },
          "message_format": {
            "description": "设置页草稿中的消息形态：text 或 markdown。",
            "type": "string"
          },
          "message_template": {
            "description": "设置页草稿中的消息模板。",
            "type": "string"
          },
          "signature": {
            "description": "设置页草稿中的消息签名。",
            "type": "string"
          }
        },
        "type": "object"
      },
      "timeoutMs": 10000
    },
    {
      "contractVersion": "sforum.qq-bot.tool.test_push@1",
      "description": "仅供管理员在插件设置页点「发一条测试消息」按钮使用，模型不应调用。它用设置页当前草稿值渲染一条样例消息，发到白名单里的第一个群，并回报渲染结果与发送结果。",
      "handler": "sforum.qq-bot.tool.test_push",
      "id": "sforum.qq-bot.tool.test_push",
      "name": "qq-bot-test-push",
      "parameters": {
        "properties": {
          "app_id": {
            "description": "设置页草稿中的 AppID。",
            "type": "string"
          },
          "app_secret": {
            "description": "设置页草稿中的 AppSecret；留空表示沿用已保存值。",
            "type": "string"
          },
          "excerpt_limit": {
            "description": "设置页草稿中的摘要长度上限，0 表示不显示摘要。",
            "type": "string"
          },
          "group_ids": {
            "description": "设置页草稿中的群 ID 列表，每行一个。",
            "type": "string"
          },
          "max_message_chars": {
            "description": "设置页草稿中的消息字数上限。",
            "type": "string"
          },
          "message_format": {
            "description": "设置页草稿中的消息形态：text 或 markdown。",
            "type": "string"
          },
          "message_template": {
            "description": "设置页草稿中的消息模板。",
            "type": "string"
          },
          "send_timeout_seconds": {
            "description": "设置页草稿中的单次发送超时（秒）。",
            "type": "string"
          },
          "signature": {
            "description": "设置页草稿中的消息签名。",
            "type": "string"
          }
        },
        "type": "object"
      },
      "timeoutMs": 10000
    },
    {
      "contractVersion": "sforum.qq-bot.tool.status@1",
      "description": "仅供管理员在插件设置页点「推送状态」按钮使用，模型不应调用。它回报凭据与白名单是否齐备、是否暂停推送、群 ID 自动识别状态，以及最近的投递结果和识别到的群 ID。",
      "handler": "sforum.qq-bot.tool.status",
      "id": "sforum.qq-bot.tool.status",
      "name": "qq-bot-status",
      "parameters": {
        "properties": {
          "app_id": {
            "description": "设置页草稿中的 AppID。",
            "type": "string"
          },
          "app_secret": {
            "description": "设置页草稿中的 AppSecret；留空表示沿用已保存值。",
            "type": "string"
          },
          "enable_group_id_claim": {
            "description": "设置页草稿中的群 ID 自动识别开关。",
            "type": "string"
          },
          "group_ids": {
            "description": "设置页草稿中的群 ID 列表，每行一个。",
            "type": "string"
          },
          "message_format": {
            "description": "设置页草稿中的消息形态：text 或 markdown。",
            "type": "string"
          },
          "paused": {
            "description": "设置页草稿中的暂停开关。",
            "type": "string"
          }
        },
        "type": "object"
      },
      "timeoutMs": 10000
    }
  ],
